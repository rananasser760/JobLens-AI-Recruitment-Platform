{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=GPDot;Integrated Security=True;TrustServerCertificate=True;"
  },
  "AIBackend": {
    "BaseUrl": "http://localhost:8000",
    "ApiKey": "super_secure_internal_shared_key_123",
    "TimeoutSeconds": 300
  },
  "Jwt": {
    "Issuer": "JobLens",
    "Audience": "JobLens.Frontend",
    "SigningKey": "dev_super_secret_secure_jwt_signing_key_min_32_chars",
    "ExpiryMinutes": 480
  },
  "Storage": {
    "RootPath": "../../data/storage"
  },
  "Security": {
    "FrontendBaseUrl": "http://localhost:4200",
    "PasswordResetTokenExpiryMinutes": 60,
    "SeedAdminEnabled": true,
    "SeedAdminEmail": "admin@joblens.local",
    "SeedAdminDisplayName": "System Admin",
    "SeedAdminPassword": "Admin@123"
  },
  "BackgroundJobs": {
    "ScrapeCron": "0 */12 * * *",
    "CleanupCron": "0 3 * * *",
    "RecommendationRefreshCron": "0 */12 * * *",
    "CleanupStaleAfterDays": 60
  },
  "Email": {
    "Enabled": false,
    "LogLinksWhenDisabled": true
  },
  "Cors": {
    "Origins": [
      "http://localhost:4200",
      "http://localhost:4000",
      "http://127.0.0.1:4200",
      "http://127.0.0.1:4000"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Demo": {
    "SeedEnabled": true,
    "Password": "Demo@12345"
  }
