{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "AIBackend": {
    "BaseUrl": "http://ai-gateway:80",
    "ApiKey": "",
    "TimeoutSeconds": 300
  },
  "Jwt": {
    "Issuer": "JobLens",
    "Audience": "JobLens.Frontend",
    "SigningKey": "",
    "ExpiryMinutes": 120,
    "RefreshTokenDays": 7
  },
  "Storage": {
    "RootPath": "/app/data/storage"
  },
  "Security": {
    "FrontendBaseUrl": "http://localhost:4200",
    "PasswordResetTokenExpiryMinutes": 30,
    "SeedAdminEnabled": false,
    "SeedAdminEmail": "admin@joblens.local",
    "SeedAdminDisplayName": "System Admin",
    "SeedAdminPassword": ""
  },
  "BackgroundJobs": {
    "ScrapeCron": "0 */6 * * *",
    "CleanupCron": "0 2 * * *",
    "RecommendationRefreshCron": "0 */8 * * *",
    "CleanupStaleAfterDays": 30,
    "AtsRetryCron": "*/30 * * * *"
  },
  "Email": {
    "Enabled": false,
    "FromAddress": "no-reply@joblens.local",
    "FromName": "JobLens",
    "SmtpHost": "",
    "SmtpPort": 587,
    "UseSsl": true,
    "Username": "",
    "Password": "",
    "LogLinksWhenDisabled": false
  },
  "Cors": {
    "Origins": [
      "http://localhost:4200",
      "http://localhost:4000",
      "http://127.0.0.1:4200",
      "http://127.0.0.1:4000"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "Demo": {
    "SeedEnabled": false,
    "Password": "",
    "RecruiterEmail": "recruiter@demo.joblens",
    "CandidateEmail": "candidate@demo.joblens"
  }
}
