# Environment & Server
JOBLENS_ENV=development
PORT=8000
JOBLENS_INTERNAL_API_KEY=super_secure_internal_shared_key_123
JOBLENS_ENABLE_PUBLIC_ROUTES=false
JOBLENS_ENABLE_DOCS=true

# CORS Origins (comma-separated)
JOBLENS_CORS_ORIGINS=http://localhost:4200,http://localhost:5245

# Database Connection (Docker / Local SQL Server)
# For Docker: Server=sql-server;Database=GPAi;UID=sa;PWD=SuperStrong!Passw0rd;TrustServerCertificate=True;
# For Local:  Server=(localdb)\MSSQLLocalDB;Database=GPAi;Integrated Security=True;TrustServerCertificate=True;
AI_SQLSERVER_CONNECTION_STRING="Server=sql-server;Database=GPAi;UID=sa;PWD=SuperStrong!Passw0rd;TrustServerCertificate=True;"
AI_SQLSERVER_ODBC_DRIVER="ODBC Driver 18 for SQL Server"