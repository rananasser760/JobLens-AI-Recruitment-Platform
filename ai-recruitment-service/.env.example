# Environment & Server
JOBLENS_ENV=development
PORT=8000
JOBLENS_INTERNAL_API_KEY=super_secure_internal_shared_key_123
JOBLENS_ENABLE_PUBLIC_ROUTES=true

# CORS Origins (comma-separated)
JOBLENS_CORS_ORIGINS=http://localhost:4200,http://localhost:5245

# LLM Provider Configuration (openrouter or groq)
JOBLENS_LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_actual_openrouter_api_key_here
GROQ_API_KEY=""

# Model Overrides (Configured to OpenRouter Free Router)
JOBLENS_PARSING_MODEL=minimax/minimax-m3:free
JOBLENS_PARSING_FALLBACK_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
JOBLENS_ATS_MODEL=minimax/minimax-m3:free
JOBLENS_SCORING_MODEL=minimax/minimax-m3:free
JOBLENS_OCR_MODEL=minimax/minimax-m3:free

# Embedding Models
JOBLENS_SCRAPER_EMBEDDING_MODEL=all-MiniLM-L6-v2
JOBLENS_CV_EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2

# ChromaDB Vector Store Path (matches docker-compose.yml mount)
JOBLENS_CHROMA_PATH=/root/.cache/chroma

# Scraper & Enrichment Settings
JOBLENS_SCRAPER_SCHEDULED=false
JOBLENS_SCRAPER_INTERVAL_HOURS=6
JOBLENS_SCRAPER_CONCURRENCY=5
JOBLENS_SCRAPER_ENRICHMENT_ENABLED=true
JOBLENS_SCRAPER_ENRICHMENT_MODEL=minimax/minimax-m3:free
JOBLENS_SCRAPER_ENRICHMENT_MAX_TOKENS=1024
JOBLENS_SCRAPER_ENRICHMENT_TEMPERATURE=0.1
JOBLENS_SCRAPER_ENRICHMENT_TIMEOUT_SECONDS=60
JOBLENS_SCRAPER_STRICT_EGYPT_ONLY=false

# Optional Ngrok Tunnel
NGROK_AUTH_TOKEN=""