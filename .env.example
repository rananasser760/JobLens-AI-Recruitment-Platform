# Copy to .env (never commit .env) and fill in real values.
# Generate random values with:  openssl rand -hex 32

# Public domain that points at your server (used for HTTPS certificates)
JOBLENS_DOMAIN=joblens.example.com

# SQL Server "sa" password: at least 8 chars with upper, lower, digit and symbol
MSSQL_SA_PASSWORD=replace_with_a_strong_password_Aa1!

# Shared secret between the .NET gateway and the Python AI services
JOBLENS_INTERNAL_API_KEY=replace_with_random_hex

# JWT signing key, at least 32 random characters
JWT_SIGNING_KEY=replace_with_random_hex

# Admin account created on first start
ADMIN_EMAIL=admin@joblens.local
ADMIN_PASSWORD=replace_with_a_strong_password

# Demo recruiter/candidate accounts (recruiter@demo.joblens / candidate@demo.joblens)
DEMO_SEED_ENABLED=true
DEMO_PASSWORD=replace_with_a_password_you_can_share
