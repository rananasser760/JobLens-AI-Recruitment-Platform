# Environment & Server
JOBLENS_ENV=development
PORT=8000
JOBLENS_INTERNAL_API_KEY=super_secure_internal_shared_key_123
JOBLENS_CORS_ORIGINS=http://localhost:4200,http://localhost:5245

# LLM Provider Configuration (openrouter or groq)
JOBLENS_LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_actual_openrouter_api_key_here
GROQ_API_KEY=""

# Interview Model (Using MiniMax M3 Free Slug)
JOBLENS_INTERVIEW_MODEL=minimax/minimax-m3:free

# Speech-to-Text (STT) Configuration
JOBLENS_STT_MODEL=nvidia/parakeet-tdt-0.6b-v2

# Text-to-Speech (TTS) Configuration
TTS_MODEL_NAME=tts_models/en/ljspeech/vits
JOBLENS_TTS_TIMEOUT_SECONDS=12.0
JOBLENS_ALLOW_SILENT_TTS_FALLBACK=false

# Documentation flag
JOBLENS_ENABLE_DOCS=true
# Refuse paid OpenRouter models (adds :free to any model name that lacks it)
JOBLENS_FREE_MODELS_ONLY=true
